config_version=5

[application]

config/name="Gallop - جالوب"
config/icon="res://icon.svg"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.101961, 0.043137, 0.180392, 1)

[autoload]

ThemeManager="*res://scripts/theme_manager.gd"
GameManager="*res://scripts/game_manager.gd"
SFX="*res://scripts/sfx_manager.gd"
HorseManager="*res://scripts/horse_manager.gd"

[display]

window/handheld/orientation=1
window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=9.8

[rendering]

textures/vram_compression/import_etc2_astc=true
